# ============================================
# Confluence RAG 시스템 환경변수 설정
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요
# cp .env.template .env
# ============================================

# --- 프록시 설정 ---
# 프록시를 사용하지 않는 경우 비워두세요

# HTTP/HTTPS 프록시 주소 (예: http://10.0.0.1:8080)
HTTP_PROXY=
HTTPS_PROXY=

# 프록시 제외 대상 (쉼표로 구분)
NO_PROXY=localhost,127.0.0.1,host.docker.internal

# --- Confluence 접속 정보 ---

# Confluence 기본 URL (회사 Atlassian 주소)
CONFLUENCE_BASE_URL=https://your-company.atlassian.net/wiki

# Confluence 로그인 이메일
CONFLUENCE_USERNAME=your-email@company.com

# Confluence API 토큰 또는 비밀번호
CONFLUENCE_PASSWORD=your-password

# 크롤링 시작 페이지 URL (여러 개는 콤마로 구분)
# 각 URL의 하위 페이지를 재귀적으로 수집합니다
ROOT_PAGE_URLS=https://your-company.atlassian.net/wiki/spaces/TEAM/pages/123456/Root1,https://your-company.atlassian.net/wiki/spaces/TEAM/pages/789012/Root2

# --- Ollama LLM 설정 ---

# Ollama 서버 주소
# Docker Compose 사용 시 (--with-ollama): http://ollama:11434
# 호스트에서 Ollama 직접 실행 시: http://host.docker.internal:11434
OLLAMA_HOST=http://ollama:11434

# 사용할 LLM 모델명 (config.py의 LLM_MODEL_DEFAULT와 일치시켜주세요)
OLLAMA_MODEL=anpigon/eeve-korean-10.8b

# --- 애플리케이션 설정 ---

# Flask 웹 서버 포트 번호
SERVER_PORT=5000

# Flask 디버그 모드 (개발 시 true, 운영 시 false)
FLASK_DEBUG=false

# --- 캐시 설정 (내부 성능 최적화용, UI 미노출) ---

# 동일 질문 재검색 시 LLM 호출 생략 (초, 기본값: 3600 = 1시간)
CACHE_TTL=3600

# 캐시 최대 항목 수
CACHE_MAX_SIZE=100

# --- 검색 기록 설정 ---

# 검색 기록 저장 파일 경로
HISTORY_FILE=search_history.json

# 최대 보관 기록 수
HISTORY_MAX_ENTRIES=200

# --- 로그 설정 ---

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
